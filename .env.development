# Development only: next dev cannot run PHP, so enquiries go to the local
# stand-in (npm run contact:mock). Production builds use /api/contact.php.
NEXT_PUBLIC_CONTACT_ENDPOINT=http://localhost:3200/api/contact.php
# The chatbot's local stand-in (same server as the contact mock).
NEXT_PUBLIC_CHAT_ENDPOINT=http://localhost:3200/api/chat.php
