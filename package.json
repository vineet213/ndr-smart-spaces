{
  "name": "ndr-smart-spaces",
  "version": "0.1.0",
  "private": true,
  "description": "Corporate website for NDR Smart Spaces Pvt. Ltd.",
  "scripts": {
    "images": "node scripts/build-images.mjs",
    "predev": "node scripts/build-images.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:next-only": "next dev",
    "prebuild": "node scripts/validate-warehouses.mjs && node scripts/build-images.mjs",
    "build": "next build",
    "postbuild": "node scripts/flatten-segment-prefetch.mjs && node scripts/build-chat-knowledge.mjs",
    "build:preview": "node scripts/validate-warehouses.mjs --allow-sample && node scripts/build-images.mjs && next build && node scripts/flatten-segment-prefetch.mjs && node scripts/build-chat-knowledge.mjs",
    "start": "node scripts/serve-static.mjs",
    "package": "npm run build && python scripts/package-for-cpanel.py",
    "contact:mock": "node scripts/contact-mock.mjs",
    "publish": "tsc -p scripts/tsconfig.cms.json && node .cms-build/scripts/cms-export.js && npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:cms": "tsc -p scripts/tsconfig.cms.json && node .cms-build/scripts/cms-verify.js",
    "cms:export": "tsc -p scripts/tsconfig.cms.json && node .cms-build/scripts/cms-export.js",
    "verify:cms:baseline": "tsc -p scripts/tsconfig.cms.json && node .cms-build/scripts/cms-verify.js --record-baseline",
    "seed:cms": "tsc -p scripts/tsconfig.cms.json && node .cms-build/scripts/cms-seed.js",
    "verify:parity": "tsc -p scripts/tsconfig.cms.json && node .cms-build/scripts/cms-parity.js",
    "verify:rbac": "tsc -p scripts/tsconfig.cms.json && node .cms-build/scripts/cms-rbac.js",
    "cms:admin": "tsc -p admin/tsconfig.json && node .cms-build/admin/server.js",
    "prepare": "husky || true",
    "postinstall": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "lenis": "^1.3.26",
    "maplibre-gl": "^6.10.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "puppeteer-core": "^25.8.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
