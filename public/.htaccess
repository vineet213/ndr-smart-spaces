# NDR Smart Spaces: Apache (cPanel) settings for the static export.
# Safe to leave in place; every block is skipped if the module is missing.

# One canonical address: https://ndrsmartspaces.com/ (no www, no /en prefix).
# Every rule below sends visitors there in a SINGLE permanent redirect.
#
# 1) Old /en/... URLs (the site used to live under /en) go to the same page without
#    the prefix. They run first and rebuild the host without "www", so even
#    http://www.host/en/x reaches https://host/x in one hop.
# 2) Any other www request goes to the non-www host over https.
# 3) Everything else on plain http is sent to https.
# Certificate-validation requests under /.well-known are never redirected.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^en/?$ https://%1/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^en/(.*/)$ https://%1/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^en/(.*[^/])$ https://%1/$1/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  RewriteCond %{HTTPS} off
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# File types Apache doesn't know by default. Without the .mjs one the browser
# refuses the map's module scripts ("non-JavaScript MIME type") and the
# portfolio map never loads.
# PHP version for api/chat.php. WHM's MultiPHP Manager keeps this setting in this
# file, and every deploy replaces the file, so the site fell back to the server's
# PHP 7.2 even though WHM showed 8.2. Keep in step with MultiPHP Manager.
# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

AddType text/javascript .mjs
AddType application/manifest+json .webmanifest

ErrorDocument 404 /404.html

# Security headers. Deliberately no Content-Security-Policy: the map, the Turnstile
# check on the forms and Next's inline scripts would need exceptions, and a mistake
# would break them. HSTS is six months and not preloaded: easy to back out if needed.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Precompressed copies. This host does not compress on the fly (the DEFLATE block
# above has no effect), so the build writes file.gz next to every page, stylesheet
# and script (scripts/precompress.mjs) and browsers that accept gzip get that copy.
# Pages and CSS arrive at about a fifth of their size. Only runs where mod_headers
# is available, since the copy must be labelled "Content-Encoding: gzip".
<IfModule mod_headers.c>
  <IfModule mod_rewrite.c>
    RewriteEngine On

    # A file request (styles, scripts, data, svg) that has a .gz copy.
    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(.+\.(?:html|css|js|mjs|json|svg|txt|xml))$ $1.gz [L,E=no-gzip:1]

    # A page address ending in "/" whose index.html has a .gz copy.
    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{REQUEST_URI} /$
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.html.gz -f
    RewriteRule ^(.*)$ $1index.html.gz [L,E=no-gzip:1]
  </IfModule>

  <FilesMatch "\.(?:html|css|js|mjs|json|svg|txt|xml)\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.html\.gz$">
    ForceType "text/html; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.css\.gz$">
    ForceType text/css
  </FilesMatch>
  <FilesMatch "\.m?js\.gz$">
    ForceType text/javascript
  </FilesMatch>
  <FilesMatch "\.json\.gz$">
    ForceType application/json
  </FilesMatch>
  <FilesMatch "\.svg\.gz$">
    ForceType image/svg+xml
  </FilesMatch>
  <FilesMatch "\.txt\.gz$">
    ForceType "text/plain; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.xml\.gz$">
    ForceType application/xml
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>
